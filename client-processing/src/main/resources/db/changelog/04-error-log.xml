<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="04-create-error-log" author="ai">
        <createTable tableName="error_log">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="service_name" type="VARCHAR(64)"/>
            <column name="type" type="VARCHAR(16)"/>
            <column name="method_signature" type="TEXT"/>
            <column name="exception_text" type="TEXT"/>
            <column name="stacktrace" type="TEXT"/>
            <column name="method_args" type="TEXT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
